# ============================================================
# Kint 環境変数設定サンプル
# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
# ============================================================

# ------ アプリケーション基本設定 ------

# JWT 署名に使用するシークレットキー（本番では必ず変更すること）
SECRET_KEY=change-me-in-production

# デバッグモード（本番では false に設定すること）
DEBUG=false

# アプリケーションの公開 URL（確認メール内のリンク生成に使用）
APP_BASE_URL=http://localhost:8000

# ------ データベース設定 ------

# SQLite データベースファイルのパス
DATABASE_URL=sqlite+aiosqlite:///./kint.db

# ------ メール確認設定 ------

# 確認メールトークンの有効期限（時間）
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ------ メール送信設定 (Resend) ------
# 確認メール・月次レポートメールは Resend (https://resend.com/) の HTTP API で送信する。
# 詳細は docs/mail-settings.md を参照。

# Resend の API キー（Resend ダッシュボード > API Keys で発行）
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 送信元アドレス。Resend でドメイン認証済みのアドレスを指定する。
# m-pass と同じ認証済みドメイン tukumana.si.aoyama.ac.jp のアドレスを使う。
# 差出人表示は「サイト名 <MAIL_FROM>」になる。
# MAIL_FROM=noreply@tukumana.si.aoyama.ac.jp

# 返信先アドレス（任意。未設定時は MAIL_FROM）
# MAIL_REPLY_TO=contact@example.com

# ------ Google Calendar API 設定 ------
# シフトカレンダー連携に使用するサービスアカウント認証情報 JSON のパス
# GOOGLE_CALENDAR_CREDENTIALS_FILE=service_account.json

# iCal 形式のシフト連携 URL
# 例: https://example.com/shift/api/ical/all?token=xxxx
SHIFT_ICAL_URL=

# ------ 打刻判定ルール設定 ------
# 連続打刻を防止するクールダウン秒数（例: 60 = 1分）
PUNCH_COOLDOWN_SECONDS=60

# シフト開始時刻より何分前から出勤打刻を「シフト内」と見なすか
SHIFT_CHECKIN_EARLY_MINUTES=10

# ------ Google Identity Services (GSI) 設定 ------
# Google Cloud Console > OAuth 2.0 クライアント ID (Web アプリケーション)
GOOGLE_CLIENT_ID=

# 管理者として自動登録を許可するパスワード（初回ログイン時のみ有効）
# 空の場合は管理者として登録できない（全員が従業員として登録される）
ADMIN_PASSWORD=